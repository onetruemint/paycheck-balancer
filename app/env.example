# Copy to .env.local (git-ignored) and adjust.
# "live" talks to the real API; "mock" uses the in-browser mock layer (src/api/mock.ts).
VITE_API_MODE=live
# Base URL for API calls. Leave empty to use same-origin /api (e.g. via the dev proxy below).
VITE_API_BASE_URL=
# Dev-server only: proxy /api to this origin, e.g. http://homelab.local:8080
VITE_API_PROXY_TARGET=
# Default mock scenario: default | item_failure | empty | no_paycheck
VITE_MOCK_SCENARIO=default
